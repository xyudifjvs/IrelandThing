APP_ENV=local
DEPLOYMENT_ENV=local
# Indexing is opt-in only on the approved production domain. These are web build inputs.
PUBLIC_SITE_URL=
SITE_INDEXING_ENABLED=false
NEXT_PUBLIC_APP_ENV=local
PORT=4000
WORKER_PORT=5000
WEB_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Exact proxy peer addresses/subnets, after verifying the hosting network. Empty trusts no forwarded IPs.
TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgresql://weatherly:weatherly_local@127.0.0.1:55432/weatherly
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
OBJECT_STORAGE_DIR=.local/objects
# Production private Railway bucket; never use local objects in production.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# Provider keys are optional for local setup; unconfigured features remain disabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_APPROVED_PROVIDERS=
OPENROUTER_ZDR_APPROVED=false
OPENROUTER_ACCOUNT_PRIVACY_VERIFIED=false
# Only Ireland's own account, initially her Stripe sandbox. No existing Carson account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_ACCOUNT_OWNER=ireland
STRIPE_MODE=test
PAYMENT_LIVE_APPROVED=false
GMAIL_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_MAILBOX=
GMAIL_REDIRECT_URI=http://127.0.0.1:3000/api/v1/communications/callback
# Set only after Ireland approves which historical messages to import.
GMAIL_IMPORT_QUERY=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
OUTBOUND_EMAIL_ENABLED=false
DOTLOOP_ENABLED=false
DOTLOOP_CLIENT_ID=
DOTLOOP_CLIENT_SECRET=
DOTLOOP_REDIRECT_URI=http://127.0.0.1:3000/api/v1/dotloop/callback
DOTLOOP_BINARY_DOWNLOAD_VERIFIED=false
RESEND_API_KEY=
SYSTEM_EMAIL_FROM=
MCP_ENABLED=false
# Explicit approved ZDR client manifest; see docs/runbooks/providers.md.
MCP_APPROVED_CLIENTS_JSON=[]
TRANSACTION_EMAIL_PLACEHOLDER=ireland@ireland.com
