20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Montserrat';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"f322d5c5-adaf-4d28-85e6-857a6babce34\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n</style>\n<style>\nbody{margin:0}\na{color:#7A6247}a:hover{color:#141210}\n</style>\n</helmet>\n<div style=\"background: #F9F6F0; color: #141210; font-family: 'Montserrat', 'Helvetica Neue', Arial, sans-serif; min-height: 100%\" data-canvas-width=\"1280\" data-canvas-height=\"1200\" data-document-role=\"page\" data-label=\"Process\">\n\n<header style=\"background: #141210; padding: 22px max(16px, 2rem) 20px; display: flex; flex-direction: column; gap: 14px\">\n<a href=\"Main.dc.html\" style=\"font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 600; font-size: 22px; letter-spacing: 0.06em; color: #FFFFFF; text-decoration: none\">WEATHERLY TRANSACTION CO.</a>\n<nav style=\"display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 12px; letter-spacing: 0.16em\">\n<a href=\"Main.dc.html\" style=\"color: #FFFFFF; text-decoration: none\">ABOUT ME</a>\n<a href=\"Services.dc.html\" style=\"color: #FFFFFF; text-decoration: none\">SERVICES</a>\n<a href=\"Process.dc.html\" style=\"color: #CBBFAF; text-decoration: none\">PROCESS</a>\n<a href=\"Onboarding.dc.html\" style=\"color: #FFFFFF; text-decoration: none\">NEW AGENT ONBOARDING</a>\n<a href=\"Portal.dc.html\" style=\"color: #FFFFFF; text-decoration: none\">AGENT PORTAL</a>\n<a href=\"Contact.dc.html\" style=\"color: #FFFFFF; text-decoration: none\">FAQ &amp; CONTACT</a>\n</nav>\n</header>\n\n<section style=\"padding: 80px 16px 96px\">\n<div style=\"max-width: 1060px; margin: 0 auto; display: flex; flex-direction: column; gap: 48px\">\n<div style=\"display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center\">\n<p style=\"margin: 0; font-size: 12px; letter-spacing: 0.24em; color: #7A6247\">HOW IT WORKS ONCE YOU'RE SIGNED UP</p>\n<h1 style=\"margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 47px; line-height: 1.05\">A Simple Process<br>From New Contract to Closing</h1>\n</div>\n<div style=\"display: flex; flex-direction: column; gap: 20px\">\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px\">\n\n<div style=\"background: #FFFFFF; border: 1px solid #E6DCCD; padding: 44px 30px 48px; display: grid; grid-row: span 3; grid-template-rows: subgrid; row-gap: 14px; align-content: start; justify-items: center; text-align: center\">\n<span style=\"font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 34px; line-height: 1; color: #7A6247\">01</span>\n<h2 style=\"margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 28px; line-height: 1.15; align-self: center\">Submit Your Transaction</h2>\n<p style=\"margin: 0; font-size: 14.5px; line-height: 1.75; color: #3D3730\">Log in to your Agent Portal and start a new transaction by completing the intake form.</p>\n</div>\n\n<div style=\"background: #FFFFFF; border: 1px solid #E6DCCD; padding: 44px 30px 48px; display: grid; grid-row: span 3; grid-template-rows: subgrid; row-gap: 14px; align-content: start; justify-items: center; text-align: center\">\n<span style=\"font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 34px; line-height: 1; color: #7A6247\">02</span>\n<h2 style=\"margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 28px; line-height: 1.15; align-self: center\">Weatherly Transaction Co. Takes It From Here</h2>\n<p style=\"margin: 0; font-size: 14.5px; line-height: 1.75; color: #3D3730\">Your transaction is added to the Weatherly Transaction Co. platform, where you and your clients each have your own view.</p>\n</div>\n\n<div style=\"background: #FFFFFF; border: 1px solid #E6DCCD; padding: 44px 30px 48px; display: grid; grid-row: span 3; grid-template-rows: subgrid; row-gap: 14px; align-content: start; justify-items: center; text-align: center\">\n<span style=\"font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 34px; line-height: 1; color: #7A6247\">03</span>\n<h2 style=\"margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 28px; line-height: 1.15; align-self: center\">Close With Confidence</h2>\n<div style=\"display: flex; flex-direction: column; gap: 14px\">\n<p style=\"margin: 0; font-size: 14.5px; line-height: 1.75; color: #3D3730\">Watch each milestone get met, with ongoing communication and support every step of the way. All that's left is handing over the keys.</p>\n\n</div>\n</div>\n\n</div>\n\n<div style=\"background: #F2EBE0; padding: 44px 40px; display: flex; flex-direction: column; gap: 28px\">\n<div style=\"display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center\">\n<p style=\"margin: 0; font-size: 12px; letter-spacing: 0.24em; color: #7A6247\">STAY IN THE LOOP</p>\n<h2 style=\"margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 36px; line-height: 1.1\">Two Portals, Always Up to Date</h2>\n</div>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 24px\">\n<div style=\"background: #FFFFFF; border: 1px solid #E6DCCD; padding: 28px 30px; display: flex; flex-direction: column; gap: 8px\">\n<p style=\"margin: 0; font-size: 12px; letter-spacing: 0.2em; color: #7A6247\">FOR YOU</p>\n<h3 style=\"margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 26px\">Agent Portal</h3>\n<p style=\"margin: 0; font-size: 14.5px; line-height: 1.75; color: #3D3730\">Track all of your transactions and see where each one stands, using the same login you use to submit new ones.</p>\n</div>\n<div style=\"background: #FFFFFF; border: 1px solid #E6DCCD; padding: 28px 30px; display: flex; flex-direction: column; gap: 8px\">\n<p style=\"margin: 0; font-size: 12px; letter-spacing: 0.2em; color: #7A6247\">FOR YOUR CLIENTS</p>\n<h3 style=\"margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 26px\">Client Portal</h3>\n<p style=\"margin: 0; font-size: 14.5px; line-height: 1.75; color: #3D3730\">A client-friendly view of updates and key transaction details, with no login required.</p>\n</div>\n</div>\n</div>\n\n</div>\n</div>\n</section>\n\n<footer style=\"background: #141210; padding: 52px 16px; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center\">\n<p style=\"margin: 0; color: #FFFFFF; font-size: 12px; letter-spacing: 0.18em\">WEATHERLY TRANSACTION CO.</p>\n<div style=\"display: flex; flex-wrap: wrap; gap: 8px 28px; justify-content: center; font-size: 13px; letter-spacing: 0.06em; color: #CBBFAF\">\n<span>ireland@weatherlytc.com</span>\n<span>419-366-5265</span>\n</div>\n<p style=\"margin: 6px 0 0; font-size: 11.5px; letter-spacing: 0.08em; color: #A89C8C\">\u00a9 2026 Weatherly Transaction Co.</p>\n</footer>\n\n</div>\n</x-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1280,&quot;height&quot;:1200}}\">\nclass Component extends DCLogic {\nrenderVals() {\nreturn {};\n}\n}\n</script>\n\n\n</body></html>"