generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Business {
  hto
  weatherly
}

model User {
  id               String              @id
  name             String
  email            String              @unique
  emailVerified    Boolean             @default(false)
  image            String?
  role             String              @default("agent")
  brokerage        String?
  twoFactorEnabled Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?
  matters          Matter[]            @relation("AgentMatters")
  participations   MatterParticipant[]
  checklistShares  ChecklistShare[]
  businessContacts BusinessContact[]
  rosterAgent       RosterAgent?
  creationReviews   CreationReview[]
  privateTodos      PrivateTodo[]
  privateScratchpad PrivateScratchpad?
  digestCursors     DigestCursor[]
}

// Private coordinator address book. Matters store copied snapshots, never a
// relation that silently replaces historical contact information on reads.
model BusinessContact {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind        String
  name        String
  company     String    @default("")
  email       String    @default("")
  phone       String    @default("")
  identityKey String
  favorite    Boolean   @default(false)
  revision    Int       @default(1)
  usageCount  Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  matterContacts MatterContact[]

  @@unique([ownerId, identityKey])
  @@index([ownerId, kind])
  @@index([ownerId, favorite])
  @@index([ownerId, lastUsedAt])
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  matterId    String?
  createdAt   DateTime  @default(now())
  rosterAgentId String?
  rosterAgent   RosterAgent? @relation(fields: [rosterAgentId], references: [id], onDelete: SetNull)

  @@index([rosterAgentId, createdAt])
}

model Matter {
  id              String              @id @default(cuid())
  title           String
  propertyAddress String
  side            String
  packageCode     String
  stage           String              @default("under_contract")
  agentId         String?
  agent           User?               @relation("AgentMatters", fields: [agentId], references: [id], onDelete: SetNull)
  revision        Int                 @default(1)
  details         Json                @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  participants    MatterParticipant[]
  tasks           Task[]
  deadlines       Deadline[]
  notes           Note[]
  documents       Document[]
  checklistShare  ChecklistShare?
  business             Business?
  checklistVersion     Int?
  acceptanceDate       String?
  acceptanceAt         DateTime?             @db.Timestamptz(3)
  deadlineTimeZone     String?
  purchasePriceCents   Decimal?              @db.Decimal(16, 0)
  agentRosterId        String?
  rosterAgent          RosterAgent?          @relation(fields: [agentRosterId], references: [id], onDelete: SetNull)
  checklistShareSecret ChecklistShareSecret?
  contacts             MatterContact[]
  confirmedReview      CreationReview?
  emailWork            EmailWork[]
  privateTodos         PrivateTodo[]
  htoClosing           HtoClosing?

  @@index([agentId, stage])
  @@index([business, stage])
  @@index([agentRosterId, stage])
}

model MatterParticipant {
  id        String    @id @default(cuid())
  matterId  String
  userId    String
  role      String
  revokedAt DateTime?
  matter    Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matterId, userId])
}

model Task {
  id         String   @id @default(cuid())
  matterId   String
  title      String
  status     String   @default("pending")
  visibility String   @default("agent")
  kind       String   @default("checklist")
  dueDate    String?
  details    Json     @default("{}")
  revision   Int      @default(1)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  stepKey     String?
  dateCapable Boolean?
  dueAt       DateTime? @db.Timestamptz(3)
  actualDate  String?
  actualAt    DateTime? @db.Timestamptz(3)
  dateRule    Json?

  @@unique([matterId, stepKey])
  @@index([matterId, status])
  @@index([matterId, position])
}

// Public lookup uses the bearer hash, including for existing hash-only links.
// One row per matter makes replacement atomic and invalidates every prior link.
model ChecklistShare {
  id         String    @id @default(cuid())
  matterId   String    @unique
  tokenHash  String    @unique
  issuedById String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  matter     Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  issuedBy   User      @relation(fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([issuedById])
}

model Deadline {
  id               String   @id @default(cuid())
  matterId         String
  label            String
  date             String?
  status           String   @default("proposed")
  sourceDocumentId String?
  details          Json     @default("{}")
  revision         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  matter           Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId, date])
}

model Note {
  id         String   @id @default(cuid())
  matterId   String
  body       String
  visibility String   @default("coordinator")
  authorId   String
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
}

model Document {
  id          String            @id @default(cuid())
  matterId    String?
  name        String
  mimeType    String
  visibility  String            @default("coordinator")
  category    String            @default("other")
  createdById String
  revision    Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  matter      Matter?           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  versions    DocumentVersion[]
  shareWithAgent     Boolean?
  shareWithClient    Boolean?
  intakeSubmissionId String?
  intakeSubmission   IntakeSubmission? @relation(fields: [intakeSubmissionId], references: [id], onDelete: SetNull)
  creationReviewId   String?
  creationReview     CreationReview?   @relation(fields: [creationReviewId], references: [id], onDelete: SetNull)

  @@index([matterId])
  @@index([intakeSubmissionId])
  @@index([creationReviewId])
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  objectKey        String   @unique
  checksum         String
  size             Int
  extractedText    String?
  pages            Json     @default("[]")
  processingStatus String   @default("pending")
  error            String?
  version          Int
  uploadedById     String?
  uploadRequestId  String?
  uploadContextHash String?
  originalName     String?
  createdAt        DateTime @default(now())
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@unique([uploadedById, uploadRequestId])
}

model IntakeDraft {
  id                String    @id @default(cuid())
  userId            String
  payload           Json      @default("{}")
  status            String    @default("draft")
  revision          Int       @default(1)
  submittedMatterId String?
  submittedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
}

model IntakeSubmission {
  id             String   @id @default(cuid())
  draftId        String   @unique
  idempotencyKey String   @unique
  userId         String
  matterId       String
  snapshot       Json
  processedAt    DateTime?
  processedById  String?
  createdAt      DateTime @default(now())
  business       Business?
  deletedAt      DateTime?
  deletedById    String?
  creationReview CreationReview?
  documents      Document[]

  @@index([processedAt, createdAt, id])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  kind      String
  payload   Json     @default("{}")
  status    String   @default("new")
  revision  Int      @default(1)
  requestId String?  @unique
  submissionHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rosterAgentId  String?
  rosterAgent    RosterAgent? @relation(fields: [rosterAgentId], references: [id], onDelete: SetNull)

  @@index([rosterAgentId, createdAt])
}

model Agreement {
  id         String   @id @default(cuid())
  userId     String
  version    String
  status     String   @default("pending")
  documentId String?
  supportingDocumentIds String[] @default([])
  agreementRequestId String? @unique
  agreementRequestHash String?
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  signedOn              String?
  rosterAgentId         String?
  rosterAgent           RosterAgent? @relation(fields: [rosterAgentId], references: [id], onDelete: SetNull)

  @@index([rosterAgentId, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  matterId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([matterId, createdAt])
}

model CatalogItem {
  code       String   @id
  name       String
  priceCents Int
  currency   String   @default("USD")
  approved   Boolean  @default(false)
  sellerOnly Boolean  @default(false)
  revision   Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model PaymentOrder {
  id                    String   @id @default(cuid())
  matterId              String
  createdById           String
  idempotencyKey        String   @unique
  kind                  String   @default("service")
  amountCents           Int
  currency              String   @default("USD")
  status                String   @default("pending")
  snapshot              Json
  stripeSessionId       String?  @unique
  stripePaymentIntentId String?
  details               Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([matterId])
}

model GiftOrder {
  id             String   @id @default(cuid())
  matterId       String
  paymentOrderId String?  @unique
  selection      Json
  status         String   @default("requested")
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model IntegrationConnection {
  id           String    @id @default(cuid())
  provider     String
  ownerId      String
  status       String    @default("disconnected")
  displayEmail String?
  credentials  String?
  scopes       Json      @default("[]")
  cursor       String?
  lastSyncedAt DateTime?
  expiresAt    DateTime?
  details      Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([provider, ownerId])
}

model DotloopLink {
  id           String    @id @default(cuid())
  matterId     String    @unique
  ownerId      String
  profileId    String
  loopId       String
  revision     Int       @default(1)
  status       String    @default("linked")
  lastSyncedAt DateTime?
  leaseUntil   DateTime?
  error        String?
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model OAuthState {
  id         String    @id @default(cuid())
  stateHash  String    @unique
  provider   String
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  verifier   String?
  createdAt  DateTime  @default(now())
}

model EmailThread {
  id               String         @id @default(cuid())
  ownerId          String
  providerThreadId String
  lifecycleKey     String         @default("primary")
  createdAt        DateTime       @default(now())
  matterId         String?
  subject          String
  status           String         @default("unassigned")
  revision         Int            @default(1)
  details          Json           @default("{}")
  updatedAt        DateTime       @updatedAt
  messages         EmailMessage[]

  @@unique([ownerId, providerThreadId, lifecycleKey])
  @@index([matterId])
}

model EmailMessage {
  id                String      @id @default(cuid())
  providerMessageId String      @unique
  threadId          String
  fromEmail         String
  to                Json        @default("[]")
  cc                Json        @default("[]")
  subject           String
  text              String
  html              String?
  sentAt            DateTime
  direction         String
  revision          Int         @default(1)
  details           Json        @default("{}")
  createdAt         DateTime    @default(now())
  thread            EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model EmailDraft {
  id                String    @id @default(cuid())
  matterId          String
  createdById       String
  to                Json
  cc                Json      @default("[]")
  subject           String
  body              String
  details           Json      @default("{}")
  attachmentIds     Json      @default("[]")
  status            String    @default("draft")
  revision          Int       @default(1)
  sendKey           String?   @unique
  providerMessageId String?
  approvedAt        DateTime?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workItemId        String?
  workItem          EmailWork? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([workItemId])
}

model CommunicationTemplate {
  serviceGroup String?
  id        String   @id @default(cuid())
  name      String
  side      String
  phase     String
  subject   String
  body      String
  revision  Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  linkedStepKey  String?
  recipientGroup String?
  recipientRoles Json?
  position       Int?
  isPlaceholder  Boolean?
  workItems      EmailWork[]
}

model AIProposal {
  id             String    @id @default(cuid())
  matterId       String
  kind           String
  status         String    @default("pending")
  result         Json
  sourceRefs     Json
  sourceRevision Int
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  model          String?
  provider       String?
  tokenUsage     Json      @default("{}")
  createdAt      DateTime  @default(now())
}

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  matterId  String?
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssistantGrant {
  id                 String    @id @default(cuid())
  userId             String
  name               String
  tokenHash          String    @unique
  scopes             Json
  approvedClient     Boolean   @default(false)
  complianceEvidence String?
  clientId           String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
}

model AssistantClient {
  id                 String   @id
  name               String
  redirectUris       Json
  approved           Boolean  @default(false)
  complianceEvidence String
  approvedById       String
  createdAt          DateTime @default(now())
}

model AssistantAuthorization {
  id            String    @id
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  state         String?
  resource      String
  codeHash      String?   @unique
  authorizedAt  DateTime?
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  side        String
  packageCode String
  definition  Json
  revision    Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookReceipt {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model OutboxJob {
  id             String    @id @default(cuid())
  topic          String
  payload        Json
  idempotencyKey String    @unique
  state          String    @default("pending")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  leaseUntil     DateTime?
  lockedBy       String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([state, availableAt])
}

// Shared across API replicas. Keys are scoped hashes, never raw email/IP values.
model RequestLimit {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}

model WorkerHeartbeat {
  id         String   @id
  lastSeenAt DateTime
}

// Provider-confirmed scheduling is intentionally separate from lead inquiries.
model SchedulingBooking {
  id String @id @default(cuid())
  inviteeUri String @unique
  eventUri String
  eventTypeUri String
  name String
  email String
  timezone String?
  startAt DateTime
  endAt DateTime
  status String
  oldInviteeUri String?
  newInviteeUri String?
  sourceUpdatedAt DateTime
  lastDeliveryHash String
  provenance String
  verifiedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rosterAgentId    String?
  rosterAgent      RosterAgent? @relation(fields: [rosterAgentId], references: [id], onDelete: SetNull)

  @@index([startAt, status])
  @@index([oldInviteeUri])
  @@index([rosterAgentId, startAt])
}

model SchedulingDelivery {
  deliveryHash String @id
  event String
  inviteeUri String
  sourceAt DateTime
  applied Boolean
  payload Json
  receivedAt DateTime @default(now())
  @@index([inviteeUri, sourceAt])
}

// A roster entry can precede an account. Name-only team entries have no email key.
model RosterAgent {
  id              String              @id @default(cuid())
  name            String
  email           String?
  normalizedEmail String?             @unique
  phone           String?
  brokerage       String?
  userId          String?             @unique
  business        Business?
  agreementSentOn String?
  archivedAt      DateTime?
  revision        Int                 @default(1)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  matters         Matter[]
  inquiries       Inquiry[]
  bookings        SchedulingBooking[]
  invitations     Invitation[]
  agreements      Agreement[]
  htoClosings     HtoClosing[]

  @@index([business, archivedAt, name])
}

// A review, including a manual review, can exist without a transaction file.
model CreationReview {
  id                      String               @id @default(cuid())
  intakeId                String?              @unique
  ownerId                 String
  state                   String               @default("open")
  revision                Int                  @default(1)
  extractionGeneration    Int                  @default(0)
  payload                 Json                 @default("{}")
  sourceRefs              Json                 @default("[]")
  startRequestId          String               @unique
  confirmedMatterId       String?              @unique
  confirmedAt             DateTime?
  confirmationRequestId   String?              @unique
  confirmationFingerprint String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  intake                  IntakeSubmission?    @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  owner                   User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  confirmedMatter         Matter?              @relation(fields: [confirmedMatterId], references: [id], onDelete: SetNull)
  extractions             CreationExtraction[]
  documents               Document[]

  @@index([ownerId, state, updatedAt])
}

model CreationExtraction {
  id            String         @id @default(cuid())
  reviewId      String
  generation    Int
  sourceRefs    Json
  promptVersion String
  status        String         @default("queued")
  result        Json?
  model         String?
  provider      String?
  errorCode     String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  review        CreationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, generation])
}

model MatterContact {
  id                 String           @id @default(cuid())
  matterId           String
  directoryContactId String?
  role               String
  name               String
  email              String           @default("")
  phone              String           @default("")
  company            String?
  shareWithAgent     Boolean          @default(false)
  shareWithClient    Boolean          @default(false)
  retiredAt          DateTime?
  revision           Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  matter             Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  directoryContact   BusinessContact? @relation(fields: [directoryContactId], references: [id], onDelete: SetNull)

  @@index([matterId, retiredAt, role])
  @@index([directoryContactId])
}

// shareId pins the encrypted token to the generation that created it. It must
// never follow a legacy ChecklistShare ID update. Copy checks the current share.
model ChecklistShareSecret {
  matterId   String @id
  shareId    String @unique
  ciphertext String
  matter     Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
}

// Delivery is read from draft/send history independently of manual completion.
model EmailWork {
  id                  String                 @id @default(cuid())
  matterId            String
  templateId          String?
  templateRevision    Int?
  linkedStepKey       String?
  laterAt             DateTime?
  remindOn            String?
  manualCompletedAt   DateTime?
  manualCompletedById String?
  revision            Int                    @default(1)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  matter              Matter                 @relation(fields: [matterId], references: [id], onDelete: Cascade)
  template            CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  drafts              EmailDraft[]

  @@unique([matterId, templateId])
  @@index([templateId])
  @@index([remindOn, matterId])
}

model PrivateTodo {
  id          String    @id @default(cuid())
  ownerId     String
  matterId    String?
  body        String
  completedAt DateTime?
  revision    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  matter      Matter?   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt, id])
  @@index([ownerId, matterId, completedAt])
  @@index([matterId])
}

model PrivateScratchpad {
  ownerId   String   @id
  body      String   @default("")
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// Manual facts are read only for unlinked rows. A linked row projects Matter.
model HtoClosing {
  id                    String       @id @default(cuid())
  matterId              String?      @unique
  manualAgentRosterId   String?
  manualPropertyAddress String?
  manualAddress         Json?
  manualClients         Json         @default("[]")
  manualSide            String?
  manualStatus          String?
  manualCloseDate       String?
  manualListedDate      String?
  manualPriceCents      Decimal?     @db.Decimal(16, 0)
  matchKey              String?
  revision              Int          @default(1)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  matter                Matter?      @relation(fields: [matterId], references: [id], onDelete: Restrict)
  manualAgent           RosterAgent? @relation(fields: [manualAgentRosterId], references: [id], onDelete: SetNull)

  @@index([matchKey, matterId])
  @@index([manualAgentRosterId, manualCloseDate])
  @@index([manualStatus, manualCloseDate])
}

model DigestCursor {
  recipientId        String
  stream             String
  highWaterAt        DateTime? @db.Timestamptz(3)
  pendingWindowStart DateTime? @db.Timestamptz(3)
  pendingWindowEnd   DateTime? @db.Timestamptz(3)
  pendingJobKey      String?   @unique
  revision           Int       @default(1)
  updatedAt          DateTime  @updatedAt
  recipient          User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([recipientId, stream])
}
