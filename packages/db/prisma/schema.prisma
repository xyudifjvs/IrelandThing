generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String              @id
  name             String
  email            String              @unique
  emailVerified    Boolean             @default(false)
  image            String?
  role             String              @default("agent")
  brokerage        String?
  twoFactorEnabled Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?
  matters          Matter[]            @relation("AgentMatters")
  participations   MatterParticipant[]
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  matterId    String?
  createdAt   DateTime  @default(now())
}

model Matter {
  id              String              @id @default(cuid())
  title           String
  propertyAddress String
  side            String
  packageCode     String
  stage           String              @default("active")
  agentId         String?
  agent           User?               @relation("AgentMatters", fields: [agentId], references: [id], onDelete: SetNull)
  revision        Int                 @default(1)
  details         Json                @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  participants    MatterParticipant[]
  tasks           Task[]
  deadlines       Deadline[]
  notes           Note[]
  documents       Document[]

  @@index([agentId, stage])
}

model MatterParticipant {
  id        String    @id @default(cuid())
  matterId  String
  userId    String
  role      String
  revokedAt DateTime?
  matter    Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matterId, userId])
}

model Task {
  id         String   @id @default(cuid())
  matterId   String
  title      String
  status     String   @default("needed")
  visibility String   @default("agent")
  kind       String   @default("checklist")
  dueDate    String?
  details    Json     @default("{}")
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId, status])
}

model Deadline {
  id               String   @id @default(cuid())
  matterId         String
  label            String
  date             String?
  status           String   @default("proposed")
  sourceDocumentId String?
  details          Json     @default("{}")
  revision         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  matter           Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId, date])
}

model Note {
  id         String   @id @default(cuid())
  matterId   String
  body       String
  visibility String   @default("coordinator")
  authorId   String
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
}

model Document {
  id          String            @id @default(cuid())
  matterId    String?
  name        String
  mimeType    String
  visibility  String            @default("coordinator")
  category    String            @default("other")
  createdById String
  revision    Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  matter      Matter?           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  versions    DocumentVersion[]

  @@index([matterId])
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  objectKey        String   @unique
  checksum         String
  size             Int
  extractedText    String?
  pages            Json     @default("[]")
  processingStatus String   @default("pending")
  error            String?
  version          Int
  createdAt        DateTime @default(now())
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model IntakeDraft {
  id                String    @id @default(cuid())
  userId            String
  payload           Json      @default("{}")
  status            String    @default("draft")
  revision          Int       @default(1)
  submittedMatterId String?
  submittedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
}

model IntakeSubmission {
  id             String   @id @default(cuid())
  draftId        String   @unique
  idempotencyKey String   @unique
  userId         String
  matterId       String
  snapshot       Json
  createdAt      DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  kind      String
  payload   Json     @default("{}")
  status    String   @default("new")
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agreement {
  id         String   @id @default(cuid())
  userId     String
  version    String
  status     String   @default("pending")
  documentId String?
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  matterId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([matterId, createdAt])
}

model CatalogItem {
  code       String   @id
  name       String
  priceCents Int
  currency   String   @default("USD")
  approved   Boolean  @default(false)
  sellerOnly Boolean  @default(false)
  revision   Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model PaymentOrder {
  id                    String   @id @default(cuid())
  matterId              String
  createdById           String
  idempotencyKey        String   @unique
  kind                  String   @default("service")
  amountCents           Int
  currency              String   @default("USD")
  status                String   @default("pending")
  snapshot              Json
  stripeSessionId       String?  @unique
  stripePaymentIntentId String?
  details               Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([matterId])
}

model GiftOrder {
  id             String   @id @default(cuid())
  matterId       String
  paymentOrderId String?  @unique
  selection      Json
  status         String   @default("requested")
  revision       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model IntegrationConnection {
  id           String    @id @default(cuid())
  provider     String
  ownerId      String
  status       String    @default("disconnected")
  displayEmail String?
  credentials  String?
  scopes       Json      @default("[]")
  cursor       String?
  lastSyncedAt DateTime?
  expiresAt    DateTime?
  details      Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([provider, ownerId])
}

model OAuthState {
  id         String    @id @default(cuid())
  stateHash  String    @unique
  provider   String
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  verifier   String?
  createdAt  DateTime  @default(now())
}

model EmailThread {
  id               String         @id @default(cuid())
  ownerId          String
  providerThreadId String
  matterId         String?
  subject          String
  status           String         @default("unassigned")
  details          Json           @default("{}")
  updatedAt        DateTime       @updatedAt
  messages         EmailMessage[]

  @@unique([ownerId, providerThreadId])
  @@index([matterId])
}

model EmailMessage {
  id                String      @id @default(cuid())
  providerMessageId String      @unique
  threadId          String
  fromEmail         String
  to                Json        @default("[]")
  cc                Json        @default("[]")
  subject           String
  text              String
  html              String?
  sentAt            DateTime
  direction         String
  details           Json        @default("{}")
  createdAt         DateTime    @default(now())
  thread            EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model EmailDraft {
  id                String    @id @default(cuid())
  matterId          String
  createdById       String
  to                Json
  cc                Json      @default("[]")
  subject           String
  body              String
  details           Json      @default("{}")
  attachmentIds     Json      @default("[]")
  status            String    @default("draft")
  revision          Int       @default(1)
  sendKey           String?   @unique
  providerMessageId String?
  approvedAt        DateTime?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CommunicationTemplate {
  id        String   @id @default(cuid())
  name      String
  side      String
  phase     String
  subject   String
  body      String
  revision  Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AIProposal {
  id             String    @id @default(cuid())
  matterId       String
  kind           String
  status         String    @default("pending")
  result         Json
  sourceRefs     Json
  sourceRevision Int
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  model          String?
  provider       String?
  tokenUsage     Json      @default("{}")
  createdAt      DateTime  @default(now())
}

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  matterId  String?
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssistantGrant {
  id                 String    @id @default(cuid())
  userId             String
  name               String
  tokenHash          String    @unique
  scopes             Json
  approvedClient     Boolean   @default(false)
  complianceEvidence String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
}

model WebhookReceipt {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model OutboxJob {
  id             String    @id @default(cuid())
  topic          String
  payload        Json
  idempotencyKey String    @unique
  state          String    @default("pending")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  leaseUntil     DateTime?
  lockedBy       String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([state, availableAt])
}
